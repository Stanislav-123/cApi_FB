# ===========================================
# apifb — Facebook Conversions API Configuration
# ===========================================

# --- Facebook Graph API ---
# Актуальная версия: v26.0 (июль 2026)
# Минимальная рекомендуемая: v22.0 (январь 2025)
# Проверьте актуальные версии: https://developers.facebook.com/docs/graph-api/changelog/
FB_GRAPH_API_VERSION=v26.0

# --- Security: HTTP Basic Auth (Web UI) ---
# Оставьте пустым для отключения защиты (не рекомендуется в продакшене)
# Формат: username:password (bcrypt не используется, plain text — для простоты)
# Пример: admin:SecurePassword123
AUTH_USER=
AUTH_PASS=

# --- Security: IP Whitelist (Postbacks) ---
# Разрешённые IP для lead.php, sale.php, reg.php, rebill.php
# Оставьте пустым для отключения проверки
# Формат: через запятую, поддерживает CIDR (например: 1.2.3.4,10.0.0.0/8)
# Пример для Keitaro: 192.168.1.100,203.0.113.0/24
ALLOWED_IPS=

# --- Default Pixel Configuration (опционально) ---
# Можно задать дефолтные значения, чтобы не передавать в каждом запросе
# Если указано в URL (sub_id_11/sub_id_12), приоритет у URL
DEFAULT_PIXEL_ID=
DEFAULT_ACCESS_TOKEN=

# --- Retry Configuration ---
# Количество повторных попыток при ошибке сети
CURL_RETRY_COUNT=3
# Начальная задержка (секунды), удваивается с каждой попыткой (exponential backoff)
CURL_RETRY_DELAY=2

# --- Currency ---
# Валюта по умолчанию для Purchase событий (если не указана в запросе)
DEFAULT_CURRENCY=USD

# ===========================================
# НЕ КОММИТЬТЕ ЭТОТ ФАЙЛ С РЕАЛЬНЫМИ ТОКЕНАМИ!
# Добавьте .env в .gitignore
# ===========================================
